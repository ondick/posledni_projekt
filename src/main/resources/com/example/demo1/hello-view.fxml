<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="720.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.demo1.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" text="Poznámková ruleta" textFill="#31d03c">
      <font>
         <Font name="System Bold" size="24.0" />
      </font></Label>
   <HBox prefHeight="400.0" prefWidth="700.0">
      <children>
         <VBox prefHeight="400.0" prefWidth="200.0">
            <children>
               <Label text="Zaci" textFill="#f81717">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
               <TextField fx:id="TextFieldZak" promptText="Jmeno zaka">
                  <VBox.margin>
                     <Insets top="3.0" />
                  </VBox.margin>
               </TextField>
               <Button mnemonicParsing="false" onMouseClicked="#pridejZaka" prefHeight="25.0" prefWidth="210.0" text="Pridat zaka">
                  <VBox.margin>
                     <Insets top="3.0" />
                  </VBox.margin>
               </Button>
               <Button mnemonicParsing="false" onMouseClicked="#odebratZaka" prefHeight="25.0" prefWidth="213.0" text="Smazat zaka">
                  <VBox.margin>
                     <Insets top="3.0" />
                  </VBox.margin>
               </Button>
               <ListView fx:id="ZaciListView" prefHeight="386.0" prefWidth="193.0">
                  <VBox.margin>
                     <Insets top="3.0" />
                  </VBox.margin>
               </ListView>
            </children>
         </VBox>
         <VBox alignment="CENTER" prefHeight="400.0" prefWidth="300.0">
            <children>
               <Button mnemonicParsing="false" onMouseClicked="#udelitPoznamku" prefHeight="25.0" prefWidth="225.0" text="Udelit poznamku">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Button>
               <Label fx:id="VybranyZakText" text="Vybrany zak:">
                  <font>
                     <Font size="15.0" />
                  </font>
               </Label>
               <Label fx:id="VybranaPoznamkaText" text="Poznamka:">
                  <font>
                     <Font size="15.0" />
                  </font>
               </Label>
            </children>
         </VBox>
         <VBox prefHeight="400.0" prefWidth="200.0">
            <children>
               <Label text="Poznamka" textFill="#f81717">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
               <TextField fx:id="TextFieldPoznamka" promptText="Text poznamky" />
               <Button mnemonicParsing="false" onMouseClicked="#pridejPoznamka" prefHeight="25.0" prefWidth="271.0" text="Pridat poznamku">
                  <VBox.margin>
                     <Insets top="3.0" />
                  </VBox.margin>
               </Button>
               <Button mnemonicParsing="false" onMouseClicked="#odebratPoznamka" prefHeight="25.0" prefWidth="283.0" text="Smazat poznamku">
                  <VBox.margin>
                     <Insets top="3.0" />
                  </VBox.margin>
               </Button>
               <ListView fx:id="PoznamkyListView" prefHeight="327.0" prefWidth="194.0">
                  <VBox.margin>
                     <Insets top="3.0" />
                  </VBox.margin>
               </ListView>
            </children>
         </VBox>
      </children>
   </HBox>
</VBox>
